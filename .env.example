# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Enquiry forms POST JSON here (e.g. https://formspree.io/f/xxxxxxx). Leave empty to fall back to the visitor's email app.
NEXT_PUBLIC_FORM_ENDPOINT=
# WhatsApp link, e.g. https://wa.me/91XXXXXXXXXX  (leave empty to hide the WhatsApp button)
NEXT_PUBLIC_WHATSAPP_URL=
